# Firebase web app settings (Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config).
# These are public identifiers (safe to have in the website); copy this file to .env and fill them in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
