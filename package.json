{
  "name": "jewellery-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --port 8788",
    "build": "vite build",
    "preview": "vite build && wrangler pages dev --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply jewellery-shop-db --local",
    "db:migrate": "wrangler d1 migrations apply jewellery-shop-db --remote",
    "deploy": "vite build && wrangler pages deploy"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "firebase": "^11.10.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  }
}
